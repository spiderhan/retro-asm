{
  "name": "Retro Assembly",
  "scopeName": "source.retroasm",
  "patterns": [
    {
      "name": "comment.block.retroasm",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "comment.line.double-slash.retroasm",
      "match": "//.*$"
    },
    {
      "name": "comment.line.asterisk.retroasm",
      "match": "^\\*.*$"
    },
    {
      "name": "comment.line.semicolon.retroasm",
      "match": ";.*$"
    },
    {
      "name": "comment.line.backslash.retroasm",
      "match": "(?<![A-Za-z0-9_'\"])\\\\.*$"
    },
    {
      "name": "comment.line.asterisk.retroasm",
      "match": "(?<=\\s)\\*(?=\\s|$).*$"
    },
    {
      "match": "^([A-Za-z_!][A-Za-z0-9_]*)(:?)(?:([ \\t]+)(\\.?[A-Za-z][A-Za-z0-9_]*))?",
      "captures": {
        "1": {
          "name": "entity.name.function.label.retroasm"
        },
        "2": {
          "name": "punctuation.separator.label.retroasm"
        },
        "4": {
          "name": "keyword.control.mnemonic.retroasm"
        }
      }
    },
    {
      "match": "^[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(:)(?:([ \\t]+)(\\.?[A-Za-z][A-Za-z0-9_]*))?",
      "captures": {
        "1": {
          "name": "entity.name.function.label.retroasm"
        },
        "2": {
          "name": "punctuation.separator.label.retroasm"
        },
        "4": {
          "name": "keyword.control.mnemonic.retroasm"
        }
      }
    },
    {
      "match": "^[ \\t]+(\\.?[A-Za-z][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.mnemonic.retroasm"
        }
      }
    },
    {
      "name": "string.quoted.single.retroasm",
      "match": "(?<![A-Za-z0-9_])'(?:[^']|'')*'"
    },
    {
      "name": "string.quoted.double.retroasm",
      "match": "\"[^\"]*\""
    },
    {
      "name": "constant.numeric.hex.retroasm",
      "match": "(?<![A-Za-z0-9_])(?:>|\\$|#|0[xX]|&)[0-9A-Fa-f]+\\b"
    },
    {
      "name": "constant.numeric.hex.retroasm",
      "match": "\\b[0-9][0-9A-Fa-f]*[hH]\\b"
    },
    {
      "name": "constant.numeric.binary.retroasm",
      "match": "(?<![A-Za-z0-9_])[:%][01]+\\b"
    },
    {
      "name": "constant.numeric.decimal.retroasm",
      "match": "\\b[0-9]+\\b"
    },
    {
      "name": "variable.language.register.retroasm",
      "match": "\\b[Rr](?:1[0-5]|[0-9])\\b"
    },
    {
      "name": "keyword.operator.retroasm",
      "match": "[@*+\\-/&|^~]"
    }
  ]
}