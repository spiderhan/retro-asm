{
  "name": "BBC BASIC",
  "scopeName": "source.bbcbasic",
  "patterns": [
    {
      "match": "^\\s*\\d+",
      "name": "constant.numeric.linenumber.bbcbasic"
    },
    {
      "begin": "(?i)\\bREM\\b",
      "end": "$",
      "name": "comment.line.rem.bbcbasic"
    },
    {
      "begin": "(?i)\\bDATA\\b",
      "end": "$",
      "name": "string.unquoted.data.bbcbasic",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.bbcbasic"
        }
      }
    },
    {
      "begin": "\\[",
      "end": "\\]",
      "name": "meta.embedded.assembly.bbcbasic",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.assembly.begin.bbcbasic"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.assembly.end.bbcbasic"
        }
      },
      "patterns": [
        {
          "match": "^\\s*\\d+",
          "name": "constant.numeric.linenumber.bbcbasic"
        },
        {
          "match": "[\\\\;].*$",
          "name": "comment.line.backslash.retroasm"
        },
        {
          "match": "(?i)\\bOPT\\b",
          "name": "keyword.other.directive.retroasm"
        },
        {
          "match": "(?<![A-Za-z0-9_])\\.[A-Za-z_][A-Za-z0-9_]*",
          "name": "entity.name.function.label.retroasm"
        },
        {
          "match": "(?i)\\b(?:ADC|AND|ASL|BCC|BCS|BEQ|BIT|BMI|BNE|BPL|BRA|BRK|BVC|BVS|CLC|CLD|CLI|CLV|CMP|CPX|CPY|DEC|DEX|DEY|EOR|INC|INX|INY|JMP|JSR|LDA|LDX|LDY|LSR|NOP|ORA|PHA|PHP|PHX|PHY|PLA|PLP|PLX|PLY|ROL|ROR|RTI|RTS|SBC|SEC|SED|SEI|STA|STX|STY|STZ|TAX|TAY|TRB|TSB|TSX|TXA|TXS|TYA)\\b",
          "name": "keyword.control.mnemonic.retroasm"
        },
        {
          "match": "(?i)\\b(?:EQU[BWDS]|SKIP|ALIGN|ORG|COPYBLOCK)\\b",
          "name": "keyword.other.directive.retroasm"
        },
        {
          "match": "\"(?:[^\"]|\"\")*\"",
          "name": "string.quoted.double.retroasm"
        },
        {
          "match": "(?<![A-Za-z0-9_])(?:&|\\$)[0-9A-Fa-f]+\\b",
          "name": "constant.numeric.hex.retroasm"
        },
        {
          "match": "%[01]+\\b",
          "name": "constant.numeric.binary.retroasm"
        },
        {
          "match": "\\b[0-9]+\\b",
          "name": "constant.numeric.decimal.retroasm"
        },
        {
          "match": "(?i)\\b[XYA]\\b",
          "name": "variable.language.register.retroasm"
        }
      ]
    },
    {
      "match": "\"(?:[^\"]|\"\")*\"",
      "name": "string.quoted.double.bbcbasic"
    },
    {
      "match": "(?<![A-Za-z0-9_])(?:&|\\$)[0-9A-Fa-f]+\\b",
      "name": "constant.numeric.hex.bbcbasic"
    },
    {
      "match": "%[01]+\\b",
      "name": "constant.numeric.binary.bbcbasic"
    },
    {
      "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b",
      "name": "constant.numeric.decimal.bbcbasic"
    },
    {
      "match": "(?<![A-Za-z0-9_])(?:PROC|FN)[A-Za-z_][A-Za-z0-9_]*",
      "name": "entity.name.function.bbcbasic"
    },
    {
      "match": "(?<![A-Za-z0-9_%$])(?:AND|OR|EOR|DIV|MOD|NOT|IF|THEN|ELSE|ENDIF|FOR|TO|STEP|NEXT|REPEAT|UNTIL|WHILE|ENDWHILE|CASE|OF|WHEN|OTHERWISE|ENDCASE|GOTO|GOSUB|RETURN|ON|PROC|ENDPROC|FN|DEF|LOCAL|DIM|LET|PRINT|INPUT|MODE|COLOUR|COLOR|GCOL|PLOT|DRAW|MOVE|VDU|SOUND|ENVELOPE|CALL|USR|LISTEN|OPENIN|OPENOUT|CLOSE|BGET|BPUT|PTR|EXT|END|STOP|RUN|CLS|CLG|RESTORE|READ|OSCLI|TIME|PAGE|HIMEM|LOMEM|RND|INT|ABS|CHR\\$|ASC|LEN|MID\\$|LEFT\\$|RIGHT\\$|STR\\$|VAL|GET|GET\\$|INKEY|INKEY\\$|TRUE|FALSE|ERR|ERL|REPORT|ERROR|WIDTH|TAB|SPC|POS|VPOS|SGN|SQR|SIN|COS|TAN|ATN|LN|LOG|EXP|PI|RAD|DEG|TRACE|OFF|CHAIN|LOAD|SAVE|OLD|NEW|LIST|RENUMBER|DELETE|AUTO|EVAL|COUNT|LINE|BY)(?![A-Za-z0-9_])",
      "name": "keyword.control.bbcbasic"
    },
    {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*[%$]?",
      "name": "variable.other.bbcbasic"
    }
  ]
}