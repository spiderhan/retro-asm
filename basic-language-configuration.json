{
  "comments": { "lineComment": "REM" },
  "brackets": [["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["\"", "\""], ["[", "]"]],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*[$%]?|[&][0-9A-Fa-f]+|\\d+"
}
