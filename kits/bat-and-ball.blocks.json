{
  "title": "Bat and ball",
  "about": "A bat you slide left and right with the joystick, and a ball that bounces off the walls and the bat. You score a point each time the bat hits the ball. A starting point: change anything you like.",
  "machine": "ti99",
  "things": {
    "bat":  { "art": "BAT_PIC",  "x": 120, "y": 168, "w": 16, "h": 4, "color": 15 },
    "ball": { "art": "BALL_PIC", "x": 124, "y": 80,  "w": 8,  "h": 8, "color": 10 }
  },
  "start": [
    { "block": "screen-colour", "colour": 4 },
    { "block": "place", "thing": "bat", "x": 120, "y": 168 },
    { "block": "place", "thing": "ball", "x": 124, "y": 80 },
    { "block": "set-speed", "thing": "ball", "across": 2, "down": 2 }
  ],
  "every_frame": [
    { "block": "move-with-joystick", "thing": "bat", "speed": 4, "leftEnd": 8, "rightEnd": 232 },
    { "block": "move-by-speed", "thing": "ball" },
    { "block": "bounce-off-walls", "thing": "ball", "left": 8, "right": 240, "top": 8 },
    { "block": "if-touching", "a": "ball", "b": "bat", "do": [
      { "block": "set-speed", "thing": "ball", "across": 2, "down": -2 },
      { "block": "add-to-score", "by": 1 },
      { "block": "play-sound", "sound": "BOING" }
    ] },
    { "block": "if-below", "thing": "ball", "line": 184, "do": [
      { "block": "place", "thing": "ball", "x": 124, "y": 80 },
      { "block": "set-speed", "thing": "ball", "across": 2, "down": 2 },
      { "block": "add-to-score", "by": -1 }
    ] },
    { "block": "show-score", "column": 1, "row": 0 }
  ],
  "data": [
    "",
    "* A 16x16 drawing is four 8x8 blocks: top-left, bottom-left, top-right, bottom-right.",
